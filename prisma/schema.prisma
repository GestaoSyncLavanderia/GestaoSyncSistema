generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Laundry {
  id            String   @id
  name          String
  email         String?
  city          String
  state         String
  street        String
  neighborhood  String
  googleMapsURL String?
  organizationId String
  ownerName      String
  ownerEmail     String
  ownerMobile    String
  revenueMetric           String  @default("paidValue")
  dayStartMinutes         Int     @default(0)
  balanceSaleInVendas     Boolean @default(false)
  balanceSaleInFaturamento Boolean @default(false)
  syncNote                String?
  createdAt      DateTime
  syncedAt       DateTime @default(now())

  sales         Sale[]
  cycles        Cycle[]
  customers     CustomerLaundry[]
  dashboardDays DashboardDay[]
}

// Resumo diário da aba Dashboard do SisLav — fonte da tela de Faturamento.
// Um registro por unidade e por dia, calculado a partir dos mesmos dados e com a mesma
// fórmula que o SisLav usa (ver lib/sislav-dashboard.ts).
model DashboardDay {
  laundryId String
  // Meia-noite UTC da data do dia no Dashboard (mesma convenção de Cycle.cycleDate)
  day       DateTime
  // Receita do dia: vendas, recargas, pacotes e lançamentos manuais de receita
  revenue   Float
  // Parte da receita que veio de lançamentos manuais (não existem na lista de vendas)
  receipts  Float    @default(0)
  // Ciclos pagos, pela regra do Dashboard
  cycles    Int
  // Quantos registros do SisLav compõem o dia
  records   Int
  syncedAt  DateTime @default(now())

  laundry Laundry @relation(fields: [laundryId], references: [id])

  @@id([laundryId, day])
  @@index([day])
}

model Sale {
  id                String    @id
  laundryId         String
  customerId        String
  customerName      String
  customerDoc       String
  customerEmail     String?
  customerMobile    String?
  customerBirthDate DateTime?
  documentType      String
  paidValue         Float
  totalValue        Float
  paymentMethod     String
  machineType       String
  machines          Int[]
  serviceType       String
  status            String    @default("")
  date              DateTime
  syncedAt          DateTime  @default(now())

  laundry  Laundry  @relation(fields: [laundryId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
}

model Cycle {
  id             String   @id @default(cuid())
  laundryId      String
  customerId     String
  machineType    String
  machinesUsed   Int[]
  machinesCount  Int
  totalPaidValue Float
  totalValue     Float
  salesCount     Int
  paymentMethod  String
  status         String   @default("")
  cycleDate      DateTime
  syncedAt       DateTime @default(now())

  laundry  Laundry  @relation(fields: [laundryId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([laundryId, customerId, machineType, cycleDate])
}

model Customer {
  id           String    @id
  name         String
  email        String?
  mobile       String?
  document     String
  documentType String
  birthDate    DateTime?
  syncedAt     DateTime  @default(now())

  sales     Sale[]
  cycles    Cycle[]
  laundries CustomerLaundry[]
}

model CustomerLaundry {
  customerId String
  laundryId  String
  customer   Customer @relation(fields: [customerId], references: [id])
  laundry    Laundry  @relation(fields: [laundryId], references: [id])

  @@id([customerId, laundryId])
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  entity    String
  status    String
  message   String?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
